---
// Một route cho toàn bộ trang + bài viết, giữ nguyên URL của site gốc.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site } from '../config/site';
import CtaBand from '../components/CtaBand.astro';

type Entry = CollectionEntry<'pages'> | CollectionEntry<'posts'>;

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const posts = await getCollection('posts');
  // Giới thiệu có trang riêng (gioi-thieu-4b-label.astro)
  return [...pages.filter((p) => p.id !== 'gioi-thieu-4b-label'), ...posts].map((entry) => ({
    params: { slug: entry.data.path.replace(/^\/|\/$/g, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: Entry };
const { Content } = await render(entry);
const pages = await getCollection('pages');
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const byOrder = (a: CollectionEntry<'pages'>, b: CollectionEntry<'pages'>) =>
  a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'vi');

const isPost = entry.collection === 'posts';
const page = isPost ? null : (entry as CollectionEntry<'pages'>);
const parent = page?.data.parent ? pages.find((p) => p.id === page.data.parent) : undefined;

// danh sách con hiển thị dưới nội dung
let listing: { href: string; title: string; image?: string; text?: string }[] = [];
let listingTitle = '';
const toCard = (p: CollectionEntry<'pages'> | CollectionEntry<'posts'>) => ({
  href: p.data.path, title: p.data.title, image: p.data.cover || undefined, text: p.data.description,
});
if (page?.id === 'san-pham-4b-label') {
  listing = pages.filter((p) => p.data.kind === 'solution' && !p.data.parent).sort(byOrder).map(toCard);
} else if (page?.id === 'dich-vu') {
  listing = pages.filter((p) => p.data.kind === 'service' && p.id !== 'dich-vu').sort(byOrder).map(toCard);
  listingTitle = 'Các dịch vụ';
} else if (page?.id === 'tin-tuc-su-kien') {
  listing = posts.map(toCard);
} else if (page) {
  listing = pages.filter((p) => p.data.parent === page.id).sort(byOrder).map(toCard);
  listingTitle = page.data.kind === 'solution' ? 'Quy cách sẵn có' : '';
}
const isContact = page?.id === 'lien-he';
const postDate = isPost
  ? new Date((entry as CollectionEntry<'posts'>).data.date).toLocaleDateString('vi-VN', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';
const intro = !isPost && page?.data.kind !== 'info' ? entry.data.description : '';

const crumbs = [{ name: 'Trang chủ', path: '/' }];
if (isPost) crumbs.push({ name: 'Tin tức & Sự kiện', path: '/tin-tuc-su-kien/' });
if (parent) crumbs.push({ name: parent.data.title, path: parent.data.path });
crumbs.push({ name: entry.data.title, path: entry.data.path });

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, Astro.site).toString(),
    })),
  },
];
if (isPost) {
  const d = (entry as CollectionEntry<'posts'>).data;
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    datePublished: d.date,
    dateModified: d.updated,
    image: d.cover ? new URL(d.cover, Astro.site).toString() : undefined,
    publisher: { '@type': 'Organization', name: site.name },
  });
}
---
<Base
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.cover || undefined}
  type={isPost ? 'article' : 'website'}
  jsonLd={jsonLd}
>
  <div class="page-head">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb" data-reveal>
        {crumbs.slice(0, -1).map((c) => <><a href={c.path}>{c.name}</a><span aria-hidden="true">/</span></>)}
      </nav>
      <h1 class="page-title" data-reveal="words">{entry.data.title}</h1>
      {postDate && <p class="page-meta" data-reveal data-delay="300">{postDate}</p>}
      {intro && <p class="page-meta lead" data-reveal data-delay="300">{intro}</p>}
    </div>
  </div>

  <div class="page-body"><div class="container">
    {isContact ? (
      <ContactBlock />
    ) : (
      <article class="prose"><Content /></article>
    )}

    {listing.length > 0 && (
      <section class="listing">
        {listingTitle && <h2>{listingTitle}</h2>}
        <div class="grid">{listing.map((c) => <Card {...c} />)}</div>
      </section>
    )}
  </div></div>

  {!isContact && <CtaBand />}
</Base>

<style>
  .page-head { position: relative; padding: clamp(150px, 20vh, 200px) 0 clamp(56px, 8vw, 96px); background: radial-gradient(110% 90% at 85% 0%, var(--navy-850), var(--navy-950) 65%); color: var(--on-dark); overflow: hidden; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.875rem; margin-bottom: 20px; color: var(--on-dark-3); }
  .crumbs a { color: var(--on-dark-2); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .page-title { font-size: clamp(2.5rem, 5.6vw, 4.75rem); font-weight: var(--w-display); letter-spacing: var(--track-display); line-height: 1.02; max-width: 18ch; }
  .page-meta { margin-top: 24px; color: var(--on-dark-2); max-width: 60ch; }
  .page-body { background: var(--white); padding-block: var(--section); }
  .listing { margin-top: 72px; }
  .listing { padding-top: 56px; border-top: 1px solid var(--line); }
  .listing h2 { font-size: clamp(1.9rem, 3.2vw, 2.75rem); margin-bottom: 40px; }
</style>

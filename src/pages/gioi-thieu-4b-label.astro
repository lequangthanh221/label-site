---
// Trang Giới thiệu dựng riêng (giữ nguyên URL cũ). Nội dung ở src/config/about.ts.
import Base from '../layouts/Base.astro';
import Stats from '../components/Stats.astro';
import CtaBand from '../components/CtaBand.astro';
import { aboutPage as a } from '../config/about';
import { emph } from '../lib/emph';

const icons: Record<string, string> = {
  idea: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.7.5 1.1 1.3 1.1 2.2h5c0-.9.4-1.7 1.1-2.2A6 6 0 0 0 12 3Z"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12.5 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
  print: '<path d="M7 8V3h10v5"/><rect x="3" y="8" width="18" height="9" rx="1.5"/><path d="M7 13h10v8H7z"/>',
  cut: '<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M8.2 7.8 20 19M8.2 16.2 20 5"/>',
};
const icon = (n: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[n]}</svg>`;

const crumbs = [{ name: 'Trang chủ', path: '/' }, { name: 'Giới thiệu', path: '/gioi-thieu-4b-label/' }];
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, Astro.site).toString() })),
}];
---
<Base title="Giới thiệu" description={a.lead} image={a.mosaic[0].src} jsonLd={jsonLd}>
  <!-- ===== đầu trang + ghép ảnh ===== -->
  <section class="ab-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb" data-reveal><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span>Giới thiệu</span></nav>
      <div class="ab-hero__grid">
        <h1 class="h-display ab-hero__title" data-reveal="words" set:html={emph(a.title)} />
        <p class="lead ab-hero__lead" data-reveal data-delay="400">{a.lead}</p>
      </div>
    </div>
  </section>
  <div class="mosaic-wrap">
    <div class="container mosaic">
      {a.mosaic.map((m, i) => (
        <figure class={`mosaic__item mosaic__item--${i}`} data-reveal data-delay={String(i * 140)}>
          <div data-parallax={['0', '-0.08', '0.06'][i]}><img src={m.src} alt={m.alt} loading={i === 0 ? 'eager' : 'lazy'} /></div>
        </figure>
      ))}
    </div>
  </div>

  <!-- ===== câu chuyện ===== -->
  <section class="section story">
    <div class="container story__grid">
      <div class="story__head">
        <span class="tag" data-reveal>{a.story.tag}</span>
        <h2 class="h-section" data-reveal="words" set:html={emph(a.story.title)} />
      </div>
      <div class="story__body">
        {a.story.paragraphs.map((p, i) => <p class={i === 0 ? 'story__first' : ''} data-reveal data-delay={String(i * 120)}>{p}</p>)}
        <div class="story__imgs">
          {a.story.images.map((m, i) => <figure data-reveal data-delay={String(i * 140)}><img src={m.src} alt={m.alt} loading="lazy" /></figure>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ra đời + trích dẫn ===== -->
  <section class="section origin">
    <div class="container origin__grid">
      <figure class="origin__img" data-reveal><img src={a.origin.image.src} alt={a.origin.image.alt} loading="lazy" /></figure>
      <div class="origin__text">
        <h2 class="h-section" data-reveal="words" set:html={emph(a.origin.title)} />
        {a.origin.paragraphs.map((p) => <p class="lead muted" data-reveal data-delay="150">{p}</p>)}
        <blockquote class="origin__quote" data-reveal data-delay="250">
          <svg viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V13.7C0 5.9 4.2 1.3 12.5 0l1.3 3.6C9.1 4.9 6.9 7.6 6.6 11.5H12V24H0Zm18 0V13.7C18 5.9 22.2 1.3 30.5 0l1.3 3.6c-4.7 1.3-6.9 4-7.2 7.9H30V24H18Z" fill="currentColor"/></svg>
          <p set:html={emph(a.origin.quote)} />
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ===== 4 bước ===== -->
  <section class="section svc">
    <div class="container">
      <div class="svc__head">
        <span class="tag" data-reveal>{a.services.tag}</span>
        <h2 class="h-section" data-reveal="words" set:html={emph(a.services.title)} />
      </div>
      <ol class="svc__list">
        {a.services.items.map((s, i) => (
          <li data-reveal data-delay={String(i * 120)}>
            <a href={s.href} class="svc__item">
              <span class="svc__top">
                <span class="svc__icon" set:html={icon(s.icon)} />
                <span class="svc__step">Bước {i + 1}</span>
              </span>
              <span class="svc__title">{s.title}</span>
              <span class="svc__go">Tìm hiểu thêm <span aria-hidden="true">↗</span></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Stats title="[[Con số]] sau mỗi cuộn tem" />

  <!-- ===== giá trị ===== -->
  <section class="section values">
    <div class="container values__grid">
      <div class="values__head">
        <span class="tag" data-reveal>{a.values.tag}</span>
        <h2 class="h-section" data-reveal="words" set:html={emph(a.values.title)} />
        <figure class="values__img" data-reveal><img src={a.values.image.src} alt={a.values.image.alt} loading="lazy" /></figure>
      </div>
      <ul class="values__list">
        {a.values.items.map((v, i) => (
          <li data-reveal data-delay={String(i * 120)}>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title={a.cta.title} text={a.cta.text} />
</Base>

<style>
  /* đầu trang */
  .ab-hero { background: radial-gradient(110% 90% at 85% 0%, var(--navy-850), var(--navy-950) 65%); color: var(--on-dark); padding: clamp(150px, 20vh, 200px) 0 clamp(140px, 16vw, 220px); }
  .crumbs { display: flex; gap: 10px; font-size: 0.875rem; color: var(--on-dark-3); margin-bottom: 24px; }
  .crumbs a { color: var(--on-dark-2); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .ab-hero__grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: end; }
  .ab-hero__title { font-size: clamp(2.5rem, 5.6vw, 5rem); }
  .ab-hero__lead { color: var(--on-dark-2); }

  /* ghép ảnh tràn lên đầu trang */
  .mosaic-wrap { background: linear-gradient(var(--navy-950) 0 50%, var(--white) 50%); margin-top: calc(-1 * clamp(100px, 12vw, 180px)); }
  .mosaic { display: grid; grid-template-columns: 1.1fr 1.6fr 1fr; gap: 16px; align-items: end; }
  .mosaic__item { margin: 0; overflow: hidden; border-radius: var(--radius-card); }
  .mosaic__item > div { height: 100%; will-change: transform; }
  .mosaic__item img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); }
  .mosaic__item--0 { aspect-ratio: 3 / 4; }
  .mosaic__item--1 { aspect-ratio: 4 / 3; }
  .mosaic__item--2 { aspect-ratio: 4 / 5; margin-bottom: 48px; }

  /* câu chuyện */
  .story { background: var(--white); }
  .story__grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px, 7vw, 120px); }
  .story__head { position: sticky; top: 120px; align-self: start; }
  .story__body { display: grid; gap: 24px; color: var(--ink-2); font-size: 1.125rem; line-height: 1.7; }
  .story__body p { max-width: 60ch; }
  .story__first { font-size: clamp(1.35rem, 2vw, 1.65rem); line-height: 1.45; color: var(--ink); font-weight: 500; letter-spacing: -0.015em; }
  .story__imgs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px; }
  .story__imgs figure { margin: 0; overflow: hidden; border-radius: var(--radius-card); aspect-ratio: 4 / 5; }
  .story__imgs figure:last-child { margin-top: 56px; }
  .story__imgs img { width: 100%; height: 100%; object-fit: cover; }

  /* ra đời */
  .origin { background: var(--paper); }
  .origin__grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .origin__img { margin: 0; overflow: hidden; border-radius: var(--radius-card); aspect-ratio: 4 / 5; }
  .origin__img img { width: 100%; height: 100%; object-fit: cover; }
  .origin__text { display: grid; gap: 24px; }
  .origin__quote { margin: 16px 0 0; padding: 32px 0 0; border-top: 1px solid var(--line); }
  .origin__quote svg { width: 32px; color: var(--accent-strong); margin-bottom: 16px; }
  .origin__quote p { font-size: clamp(1.4rem, 2.3vw, 2rem); font-weight: 600; line-height: 1.3; letter-spacing: -0.025em; color: var(--ink); }

  /* 4 bước */
  .svc { background: var(--white); }
  .svc__head { max-width: 640px; margin-bottom: clamp(48px, 6vw, 72px); }
  .svc__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .svc__list li + li { border-left: 1px solid var(--line); }
  .svc__item { display: grid; grid-template-rows: auto 1fr auto; gap: 28px; height: 100%; padding: 32px 28px 32px 0; text-decoration: none; position: relative; }
  .svc__list li + li .svc__item { padding-left: 28px; }
  .svc__item::before { content: ''; position: absolute; top: -1px; left: 0; width: 0; height: 2px; background: var(--accent-strong); transition: width 0.6s var(--ease-out); }
  .svc__item:hover::before { width: 100%; }
  .svc__top { display: flex; align-items: center; justify-content: space-between; }
  .svc__icon { width: 56px; height: 56px; display: grid; place-items: center; background: var(--navy-900); color: var(--accent); border-radius: var(--radius-card); transition: background 0.4s, color 0.4s, transform 0.6s var(--ease-out); }
  .svc__icon :global(svg) { width: 26px; height: 26px; }
  .svc__item:hover .svc__icon { background: var(--accent); color: var(--navy-950); transform: rotate(-6deg); }
  .svc__step { font-size: 0.875rem; font-weight: 600; color: var(--accent-strong); }
  .svc__title { font-size: clamp(1.2rem, 1.6vw, 1.45rem); font-weight: 600; line-height: 1.25; letter-spacing: -0.02em; color: var(--ink); }
  .svc__go { font-size: 0.9rem; font-weight: 600; color: var(--ink-3); transition: color 0.3s; }
  .svc__item:hover .svc__go { color: var(--accent-strong); }

  /* giá trị */
  .values { background: var(--white); }
  .values__grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px, 7vw, 120px); }
  .values__img { margin: 40px 0 0; overflow: hidden; border-radius: var(--radius-card); aspect-ratio: 4 / 3; }
  .values__img img { width: 100%; height: 100%; object-fit: cover; }
  .values__list { list-style: none; margin: 0; padding: 0; align-self: center; }
  .values__list li { padding: 36px 0; border-top: 1px solid var(--line); display: grid; gap: 12px; }
  .values__list li:last-child { border-bottom: 1px solid var(--line); }
  .values__list h3 { font-size: clamp(1.6rem, 2.6vw, 2.25rem); line-height: 1.1; }
  .values__list p { color: var(--ink-2); font-size: 1.1rem; max-width: 52ch; }

  @media (max-width: 960px) {
    .ab-hero__grid, .story__grid, .origin__grid, .values__grid { grid-template-columns: 1fr; }
    .story__head { position: static; }
    .svc__list { grid-template-columns: 1fr 1fr; }
    .svc__list li:nth-child(3) { border-left: 0; }
    .svc__list li:nth-child(3) .svc__item { padding-left: 0; }
    .svc__list li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    .mosaic { grid-template-columns: 1fr 1fr; }
    .mosaic__item--1 { grid-column: 1 / -1; grid-row: 1; }
    .mosaic__item--2 { margin-bottom: 0; }
    .svc__list { grid-template-columns: 1fr; }
    .svc__list li + li { border-left: 0; border-top: 1px solid var(--line); }
    .svc__list li + li .svc__item { padding-left: 0; }
  }
</style>

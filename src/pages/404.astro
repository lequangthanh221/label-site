---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Không tìm thấy trang">
  <section class="nf">
    <div class="container">
      <p class="nf__code">404</p>
      <h1>Không tìm thấy trang</h1>
      <p class="nf__text">Trang bạn tìm có thể đã được đổi địa chỉ.</p>
      <Button href="/">Về trang chủ</Button>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 80vh; display: grid; align-items: center; padding: 160px 0 96px; background: var(--navy-950); color: var(--on-dark); }
  .nf__code { font-size: clamp(5rem, 16vw, 12rem); letter-spacing: -0.06em; line-height: 1; color: var(--accent); }
  .nf h1 { font-size: clamp(2rem, 4vw, 3rem); margin: 12px 0; }
  .nf__text { color: var(--on-dark-2); margin-bottom: 32px; }
</style>

---
interface Props { href: string; title: string; image?: string; text?: string }
const { href, title, image, text } = Astro.props;
---
<a class="card" href={href} data-reveal>
  <div class="card__img">{image ? <img src={image} alt="" loading="lazy" /> : <span aria-hidden="true"></span>}</div>
  <div class="card__body">
    <h3>{title}</h3>
    {text && <p>{text}</p>}
    <span class="card__go">Xem chi tiết ↗</span>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .card__img { overflow: hidden; border-radius: var(--radius-card); aspect-ratio: 4 / 3; background: var(--paper); }
  .card__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out); }
  .card:hover .card__img img { transform: scale(1.06); }
  .card__body { padding-top: 18px; display: grid; gap: 8px; }
  .card h3 { font-size: 1.3rem; line-height: 1.2; transition: color 0.3s; }
  .card:hover h3 { color: var(--accent-strong); }
  .card p { color: var(--ink-3); font-size: 0.925rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card__go { font-size: 0.875rem; font-weight: 500; color: var(--ink); }
</style>

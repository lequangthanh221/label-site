---
import { site } from '../config/site';
const { contact, formAction } = site;
---
<div class="contact">
  <div>
    <h2>Mọi yêu cầu hợp tác vui lòng liên hệ với chúng tôi</h2>
    <dl>
      <dt>Điện thoại</dt><dd><a href={contact.phoneHref}>{contact.phone}</a></dd>
      <dt>Email</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
      <dt>Địa chỉ</dt><dd>{contact.address}</dd>
    </dl>
    {contact.mapEmbed && <iframe src={contact.mapEmbed} title="Bản đồ" loading="lazy" class="map"></iframe>}
  </div>

  <form method="post" action={formAction || `mailto:${contact.email}`} enctype={formAction ? undefined : 'text/plain'}>
    <label>Tên của bạn <input name="name" required autocomplete="name" /></label>
    <label>Email <input name="email" type="email" required autocomplete="email" /></label>
    <label>Số điện thoại <input name="phone" type="tel" autocomplete="tel" /></label>
    <label>Nội dung <textarea name="message" rows="6" required></textarea></label>
    <button class="btn" type="submit">Gửi yêu cầu</button>
  </form>
</div>

<style>
  .contact { display: grid; gap: 48px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .contact h2 { margin-top: 0; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 8px 24px; }
  dt { font-weight: 600; }
  dd { margin: 0; }
  .map { width: 100%; aspect-ratio: 4 / 3; border: 0; border-radius: var(--radius); margin-top: 24px; }
  form { display: grid; gap: 16px; }
  label { display: grid; gap: 6px; font-weight: 600; }
  input, textarea { font: inherit; padding: 10px 12px; border: 1px solid var(--color-line); border-radius: var(--radius); }
  button { border: 0; cursor: pointer; justify-self: start; font: inherit; font-weight: 600; }
</style>

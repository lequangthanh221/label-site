---
import { site, nav } from '../config/site';
import Logo from './Logo.astro';
const current = Astro.url.pathname;
const isActive = (href: string, children?: { href: string }[]) =>
  current === href || !!children?.some((c) => c.href === current);
---
<header class="hd" data-header>
  <div class="container hd__inner">
    <a href="/" class="hd__logo"><Logo /></a>

    <nav class="hd__nav" aria-label="Chính">
      <ul>
        {nav.filter((i) => i.href !== '/lien-he/').map((item) => (
          <li class={item.children ? 'has-sub' : ''}>
            <a href={item.href} class="hd__link" aria-current={isActive(item.href, item.children) ? 'page' : undefined}>
              <span class="hd__roll" data-text={item.label}>{item.label}</span>
            </a>
            {item.children && (
              <div class="hd__sub">
                <ul>
                  {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a href="/lien-he/" class="hd__cta">Liên hệ</a>

    <button class="hd__burger" aria-label="Mở menu" aria-expanded="false" aria-controls="mnav" data-burger>
      <span></span><span></span>
    </button>
  </div>

  <div class="mnav" id="mnav" data-mnav hidden>
    <div class="container">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
            {item.children && (
              <ul class="mnav__sub">{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
            )}
          </li>
        ))}
      </ul>
      <p class="mnav__contact"><a href={site.contact.phoneHref}>{site.contact.phone}</a><br /><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
    </div>
  </div>
</header>

<style>
  .hd { position: fixed; inset: 0 0 auto; z-index: 50; color: var(--on-dark); transition: background 0.4s var(--ease-out), backdrop-filter 0.4s, transform 0.5s var(--ease-out); }
  .hd.is-scrolled { background: rgb(4 11 24 / 0.72); backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%); }
  .hd.is-hidden { transform: translateY(-100%); }
  .hd__inner { display: flex; align-items: center; gap: 32px; height: 76px; }
  .hd__logo { text-decoration: none; margin-right: auto; }

  .hd__nav > ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .hd__link { display: block; padding: 8px 14px; text-decoration: none; font-size: 0.95rem; font-weight: 500; color: var(--on-dark-2); transition: color 0.3s; }
  .hd__link:hover, .hd__link[aria-current='page'] { color: var(--on-dark); }
  /* chữ cuộn lên khi hover */
  .hd__roll { display: inline-block; position: relative; overflow: hidden; vertical-align: top; line-height: 1.3; }
  .hd__roll::after { content: attr(data-text); position: absolute; left: 0; top: 100%; color: var(--on-dark); }
  .hd__roll, .hd__roll::after { transition: transform 0.45s var(--ease-out); }
  .hd__link:hover .hd__roll { transform: translateY(-100%); }

  .has-sub { position: relative; }
  .hd__sub { position: absolute; top: 100%; left: 0; padding-top: 10px; opacity: 0; visibility: hidden; transform: translateY(8px); transition: 0.35s var(--ease-out); }
  .has-sub:hover .hd__sub, .has-sub:focus-within .hd__sub { opacity: 1; visibility: visible; transform: none; }
  .hd__sub ul { list-style: none; margin: 0; padding: 10px; min-width: 280px; background: var(--navy-900); border: 1px solid var(--line-dark); border-radius: var(--radius-card); box-shadow: 0 24px 48px rgb(0 0 0 / 0.35); }
  .hd__sub a { display: block; padding: 8px 12px; text-decoration: none; font-size: 0.9rem; color: var(--on-dark-2); border-radius: var(--radius); transition: background 0.2s, color 0.2s; }
  .hd__sub a:hover { background: var(--navy-800); color: var(--on-dark); }

  .hd__cta { padding: 10px 18px; border: 1px solid rgb(255 255 255 / 0.22); border-radius: var(--radius); text-decoration: none; font-size: 0.9rem; transition: background 0.3s, border-color 0.3s, color 0.3s; }
  .hd__cta:hover { background: var(--accent); border-color: var(--accent); color: var(--navy-950); }

  .hd__burger { display: none; width: 44px; height: 44px; background: none; border: 1px solid rgb(255 255 255 / 0.22); border-radius: var(--radius); cursor: pointer; position: relative; }
  .hd__burger span { position: absolute; left: 12px; right: 12px; height: 1.5px; background: var(--on-dark); transition: transform 0.35s var(--ease-out); }
  .hd__burger span:first-child { top: 17px; }
  .hd__burger span:last-child { top: 25px; }
  .hd__burger[aria-expanded='true'] span:first-child { transform: translateY(4px) rotate(45deg); }
  .hd__burger[aria-expanded='true'] span:last-child { transform: translateY(-4px) rotate(-45deg); }

  .mnav { background: var(--navy-950); border-top: 1px solid var(--line-dark); max-height: calc(100dvh - 76px); overflow-y: auto; padding-block: 16px 32px; }
  .mnav ul { list-style: none; margin: 0; padding: 0; }
  .mnav > .container > ul > li { border-bottom: 1px solid var(--line-dark); padding-block: 12px; }
  .mnav a { text-decoration: none; font-size: 1.35rem; letter-spacing: -0.02em; }
  .mnav__sub { padding: 8px 0 4px 2px !important; display: grid; gap: 6px; }
  .mnav__sub a { font-size: 0.975rem; color: var(--on-dark-2); }
  .mnav__contact { margin-top: 24px; color: var(--on-dark-2); line-height: 1.9; }

  @media (max-width: 1023px) {
    .hd__nav, .hd__cta { display: none; }
    .hd__burger { display: block; }
    .hd.is-open { background: var(--navy-950); }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const burger = header.querySelector<HTMLButtonElement>('[data-burger]')!;
  const mnav = header.querySelector<HTMLElement>('[data-mnav]')!;
  let lastY = 0;
  const onScroll = () => {
    const y = window.scrollY;
    header.classList.toggle('is-scrolled', y > 24);
    // ẩn khi cuộn xuống, hiện khi cuộn lên
    header.classList.toggle('is-hidden', y > 400 && y > lastY && !header.classList.contains('is-open'));
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  burger.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') !== 'true';
    burger.setAttribute('aria-expanded', String(open));
    header.classList.toggle('is-open', open);
    mnav.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  });
</script>

---
import { site, nav } from '../config/site';
const current = Astro.url.pathname;
---
<header class="header">
  <div class="topbar">
    <div class="container topbar__inner">
      <a href={site.contact.phoneHref}>{site.contact.phone}</a>
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    </div>
  </div>
  <div class="container header__inner">
    <a href="/" class="logo" aria-label={site.name}>
      <img src={site.logo} alt={site.name} width="160" height="40" />
    </a>
    <details class="menu">
      <summary aria-label="Mở menu">Menu</summary>
      <nav aria-label="Chính">
        <ul>
          {nav.map((item) => (
            <li class={item.children ? 'has-sub' : ''}>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
              {item.children && (
                <ul class="sub">
                  {item.children.map((c) => (
                    <li><a href={c.href} aria-current={current === c.href ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .topbar { background: var(--color-brand); color: var(--color-brand-contrast); font-size: 0.875rem; }
  .topbar a { color: inherit; text-decoration: none; }
  .topbar__inner { display: flex; gap: 24px; justify-content: flex-end; padding-block: 6px; flex-wrap: wrap; }
  .header { border-bottom: 1px solid var(--color-line); background: var(--color-surface); position: sticky; top: 0; z-index: 10; }
  .header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 72px; gap: 24px; }
  .logo img { height: 40px; width: auto; }
  nav ul { list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--color-ink); text-decoration: none; font-weight: 600; }
  nav a[aria-current='page'] { color: var(--color-brand); }

  /* mobile: menu xổ dọc */
  .menu summary { cursor: pointer; font-weight: 600; list-style: none; padding: 8px 12px; border: 1px solid var(--color-line); border-radius: var(--radius); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu[open] nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--color-surface); border-bottom: 1px solid var(--color-line); padding: 16px var(--gutter); max-height: 75vh; overflow-y: auto; }
  .menu nav li { padding: 6px 0; }
  .menu .sub { padding-left: 16px; font-size: 0.95rem; }
  .menu .sub a { font-weight: 400; }

  @media (min-width: 1024px) {
    .menu summary { display: none; }
    .menu nav, .menu[open] nav { display: block; position: static; padding: 0; border: 0; max-height: none; overflow: visible; }
    .menu > nav > ul { display: flex; gap: 28px; }
    .has-sub { position: relative; }
    .menu .sub {
      display: none; position: absolute; top: 100%; left: -16px; min-width: 260px; padding: 12px 16px;
      background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius);
      box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
    }
    .has-sub:hover .sub, .has-sub:focus-within .sub { display: block; }
  }
</style>

<script>
  // desktop: menu luôn mở; mobile: dùng details/summary
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const mq = window.matchMedia('(min-width: 1024px)');
  const sync = () => { if (menu) menu.open = mq.matches; };
  mq.addEventListener('change', sync);
  sync();
</script>

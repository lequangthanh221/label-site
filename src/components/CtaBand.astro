---
import Button from './Button.astro';
import { site } from '../config/site';
import { emph } from '../lib/emph';
interface Props { title?: string; text?: string }
const {
  title = 'Cần tư vấn tem nhãn cho [[sản phẩm]] của bạn?',
  text = `Gọi ${site.contact.phone} hoặc gửi yêu cầu, chúng tôi phản hồi trong ngày.`,
} = Astro.props;
---
<section class="cta-band dark">
  <div class="container cta-band__inner">
    <div>
      <h2 data-reveal="words" set:html={emph(title)} />
      <p data-reveal data-delay="200">{text}</p>
    </div>
    <div data-reveal data-delay="300"><Button href="/lien-he/">Liên hệ ngay</Button></div>
  </div>
</section>
<style>
  .cta-band { padding-block: clamp(64px, 9vw, 112px); background: radial-gradient(60% 120% at 100% 0%, var(--navy-800), var(--navy-900) 70%); }
  .cta-band__inner { display: flex; flex-wrap: wrap; gap: 32px; align-items: end; justify-content: space-between; }
  .cta-band h2 { font-size: clamp(2rem, 3.8vw, 3.25rem); max-width: 18ch; }
  .cta-band p { margin-top: 16px; color: var(--on-dark-2); font-size: 1.1rem; }
</style>
